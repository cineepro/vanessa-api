# ⚠️ MÊME PROJET APPWRITE QUE ÇA PARLE — c'est ce qui garantit un compte
# utilisateur unique entre les deux sites, sans double inscription.
# Copie ici exactement les mêmes valeurs ENDPOINT / PROJECT_ID /
# DATABASE_ID / COLLECTION_USERS que dans le .env de ça-parle.

VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=

# Collection users : la même que ça-parle (compte partagé)
VITE_APPWRITE_COLLECTION_USERS=

# Nouvelles collections de cette plateforme (créées dans le même projet)
VITE_APPWRITE_COLLECTION_API_KEYS=
VITE_APPWRITE_COLLECTION_API_KEY_REQUESTS=
VITE_APPWRITE_COLLECTION_API_USAGE_LOGS=

# Functions de cette plateforme
VITE_APPWRITE_FUNCTION_MANAGE_API_KEYS=
VITE_APPWRITE_FUNCTION_ADMIN_API_KEYS=

# URL publique de la Function vanessa-api (celle que les développeurs
# appellent) — affichée telle quelle dans la documentation du site.
VITE_VANESSA_API_URL=https://api.kinemaplus.com
